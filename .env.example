# Finora Environment Configuration Template

# Server & Node
NODE_ENV=development
PORT=3000
API_PORT=8080
AI_SERVICE_PORT=8000

# PostgreSQL Canonical Database
DATABASE_URL=postgres://finora:finora_dev_secret@localhost:5432/finora_db?sslmode=disable
POSTGRES_USER=finora
POSTGRES_PASSWORD=finora_dev_secret
POSTGRES_DB=finora_db

# NATS JetStream Event Messaging
NATS_URL=nats://localhost:4222

# Redis Ephemeral Cache & Rate Limiting
REDIS_URL=redis://localhost:6379

# Object Storage (MinIO local / S3 production)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=finora-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_SSL=false

# Authentication Secrets
JWT_SECRET=super_secret_finora_jwt_token_change_in_production_32bytes
SESSION_SECRET=super_secret_finora_session_token_32bytes

# AI Provider Credentials & Configuration
# Supported providers: mock, openai, anthropic, gemini, local
AI_PROVIDER=mock
AI_MODEL=mock-v1
AI_API_KEY=

# Application Locales & Default Currency
DEFAULT_CURRENCY=BRL
DEFAULT_LOCALE=pt-BR
TIMEZONE=America/Sao_Paulo

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
